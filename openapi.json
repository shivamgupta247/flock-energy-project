            "title": "Snapshot Loaded At",
            "description": "When the fleet snapshot was last pulled from the portal (UTC)."
          },
          "stale": {
            "type": "boolean",
            "title": "Stale",
            "description": "True if the snapshot is past its TTL because the last refresh failed."
          }
        },
        "type": "object",
        "required": [
          "stale"
        ],
